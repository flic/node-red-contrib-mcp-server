[
    {
        "id": "ex-admin-tab",
        "type": "tab",
        "label": "MCP Admin and MCP Call",
        "disabled": false,
        "info": "Two things this package does besides serving your own tools.\n\n**MCP Admin** administers this Node-RED over MCP. It has a server of its own (path `nodered`), so which clients may administer Node-RED is one resource at your identity provider. Its output carries one message per change; here it goes to a debug node, in practice to a notification or a log. Give it an admin token (see its help for the settings.js entry) before deploying.\n\n**MCP Call** reaches tools on a server from a flow, without MCP or a token. Press the inject to list what the admin server offers."
    },
    {
        "id": "ex-admin-server",
        "type": "ftb-mcp-server",
        "name": "Node-RED admin",
        "path": "nodered",
        "serverUrl": "",
        "filterHost": false,
        "serverName": "",
        "instructions": "Administers this Node-RED: read and search flows, change them node by node, test them with inject and the debug sidebar, and roll back.",
        "issuerUrl": "",
        "extraScopes": "",
        "audience": "",
        "tokenCacheTTL": 300,
        "localDebugGroups": "",
        "requiredClaim": "groups",
        "requiredValue": "",
        "requiredScope": ""
    },
    {
        "id": "ex-admin",
        "type": "ftb-mcp-admin",
        "z": "ex-admin-tab",
        "name": "",
        "mcpServer": "ex-admin-server",
        "instanceName": "",
        "instanceDescription": "",
        "groupRead": true,
        "groupFlows": true,
        "groupTest": true,
        "groupContext": false,
        "writeRequiredValue": "",
        "snapshots": 50,
        "adminPort": "",
        "x": 140,
