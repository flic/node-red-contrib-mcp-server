{
  "name": "@frtnbach/node-red-contrib-mcp-server",
  "version": "3.0.1",
  "description": "Generic Model Context Protocol (MCP) server nodes for Node-RED: expose flows as MCP tools behind an OAuth-protected endpoint, and administer Node-RED itself over MCP with a dedicated admin node.",
  "keywords": [
    "node-red",
    "mcp",
    "model-context-protocol",
    "ai",
    "oauth"
  ],
  "author": "Fredrik Furtenbach",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flic/node-red-contrib-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/flic/node-red-contrib-mcp-server/issues"
  },
  "homepage": "https://github.com/flic/node-red-contrib-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "nodes/",
    "lib/",
    "plugins/",
    "resources/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "eslint nodes lib plugins resources test scripts examples-src && mocha \"test/**/*.test.js\" && node --test examples-src/sl/lib.test.js",
    "test:announce": "node --env-file=.env scripts/bsky-announce.js",
    "lint": "eslint nodes lib plugins resources test scripts examples-src"
  },
  "engines": {
    "node": ">=22"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "ftb-mcp-server": "nodes/mcp-server.js",
      "ftb-mcp-in": "nodes/mcp-in.js",
      "ftb-mcp-out": "nodes/mcp-out.js",
      "ftb-mcp-call": "nodes/mcp-call.js",
      "ftb-mcp-admin": "nodes/mcp-admin.js",
      "ftb-mcp-legacy": "nodes/legacy.js"
    },
    "plugins": {
      "ftb-mcp-migrate": "plugins/migrate.js"
    }
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@atproto/api": "^0.20.34",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "mocha": "^10.7.3"
  }
}
