{
  "name": "@frtnbach/node-red-contrib-mcp-server",
  "version": "0.4.0",
  "description": "Generic Model Context Protocol (MCP) server nodes for Node-RED: expose flows as MCP tools behind an OAuth-protected endpoint, with optional Node-RED admin (flow read/deploy) tools.",
  "keywords": [
    "node-red",
    "mcp",
    "model-context-protocol",
    "ai",
    "oauth"
  ],
  "author": "Fredrik Furtenbach",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flic/node-red-contrib-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/flic/node-red-contrib-mcp-server/issues"
  },
  "homepage": "https://github.com/flic/node-red-contrib-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "nodes/",
    "lib/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha \"test/**/*.test.js\"",
    "postpublish": "node --env-file=.env scripts/bsky-announce.js",
    "test:announce": "node --env-file=.env scripts/bsky-announce.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "node-red": {
    "version": ">=2.2.0",
    "nodes": {
      "mcp-server": "nodes/mcp-server.js",
      "mcp-in": "nodes/mcp-in.js",
      "mcp-out": "nodes/mcp-out.js"
    }
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@atproto/api": "^0.20.34",
    "mocha": "^10.7.3"
  }
}
